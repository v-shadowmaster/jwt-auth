{
  "compilerOptions": {
    "target": "ES2020",         // Modern JS version
    "module": "CommonJS",       // Node.js module system
    "outDir": "dist",           // Output folder for JS files
    "rootDir": "./",            // Root folder for your TS files
    "strict": true,             // Enable strict type checks
    "esModuleInterop": true,    // Needed for importing npm packages easily
    "skipLibCheck": true        // Skip type checking for dependencies
  },
  "include": [
    "*.ts",
    "**/*.ts"
  ]
}